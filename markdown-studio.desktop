[Desktop Entry]
Type=Application
Version=1.0
Name=Markdown Studio
GenericName=Markdown Editor
Comment=Write Markdown with a live preview
Exec=@EXEC@ %F
Icon=markdown-studio
Terminal=false
Categories=Utility;TextEditor;
Keywords=markdown;editor;notes;writing;preview;
MimeType=text/markdown;
StartupNotify=true
StartupWMClass=io.github.markdownstudio.MarkdownStudio
